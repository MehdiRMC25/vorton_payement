# Server
# Use production when deploying (e.g. Render). For Render, set NODE_ENV=production in Dashboard → Environment.
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Allowed origins (comma-separated) — for website and mobile app
# Example: https://yourapp.com,https://www.yourapp.com,capacitor://localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth — API key or JWT secret for mobile app / website
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=
JWT_SECRET=

# Auth.js (sign-in) — optional; if set, /auth and /api/v1/auth/session are enabled
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# GitHub OAuth (optional; if set with AUTH_SECRET, sign in with GitHub is available)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Kapital Bank E-commerce API
# Test: https://txpgtst.kapitalbank.az/api
# Prod: https://e-commerce.kapitalbank.az/api
KAPITAL_BASE_URL=https://e-commerce.kapitalbank.az/api
KAPITAL_USERNAME=TerminalSys/kapital
KAPITAL_PASSWORD=kapital123
# Where Kapital redirects the user after payment (your frontend/app URL that receives ID & STATUS)
CALLBACK_URL=https://yourdomain.com/api/payment/callback

# Your business (for receipts / statements)
BUSINESS_NAME=Your Business Name
SUPPORT_EMAIL=support@example.com

# Email (order notifications — sent from bot@vorton.uk to orders@vorton.com)
# Also used for profile email-change verification codes (POST .../auth/profile/email/request-code)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=bot@vorton.uk
EMAIL_TO=orders@vorton.com

# MongoDB (products catalog — vorton_app database)
# Same MONGODB_URI used by vorton-mob-app. Required for /api/products.
MONGODB_URI=
# Cloudinary (product images — required for image-existence filter)
# API_KEY and API_SECRET are needed to list resources; if not set, all products pass the filter.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PostgreSQL (customers / auth)
# Option 1: single URL (e.g. Render provides DATABASE_URL)
DATABASE_URL=
# Option 2: separate vars (local dev)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=Vorton
